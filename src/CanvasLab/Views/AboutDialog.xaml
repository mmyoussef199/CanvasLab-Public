<Window x:Class="CanvasLab.Views.AboutDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="About CanvasLab" Icon="/CanvasLab;component/Assets/CanvasLab.ico"
 Width="560" SizeToContent="Height" MaxHeight="720" ResizeMode="NoResize" ShowInTaskbar="False"
 WindowStartupLocation="CenterOwner" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Border Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource MenuBorderBrush}" BorderThickness="1" Padding="28">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="108"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Width="96" Height="96" CornerRadius="18" Background="#17243A" BorderBrush="#355683" BorderThickness="1" VerticalAlignment="Top">
     <Image Source="/CanvasLab;component/Assets/CanvasLab-About.png" Width="80" Height="80" Stretch="Uniform"
            RenderOptions.BitmapScalingMode="HighQuality"/>
    </Border>
    <StackPanel Grid.Column="1" Margin="18,2,0,0">
     <TextBlock Text="CanvasLab" FontSize="28" FontWeight="SemiBold"/>
     <TextBlock Text="{Binding VersionText}" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0"/>
     <TextBlock Text="Developed by Mohamed Youssef" Foreground="#C8CFDC" Margin="0,10,0,0"/>
    </StackPanel>
   </Grid>
   <StackPanel Grid.Row="1" Margin="0,24,0,0">
    <TextBlock Text="Offline Windows image tool for picking colors and optimizing images for the web." FontSize="15" LineHeight="23" TextWrapping="Wrap"/>
    <Border Height="1" Background="#343B47" Margin="0,22,0,20"/>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="Copyright" Foreground="{StaticResource MutedTextBrush}"/>
     <TextBlock Grid.Column="1" Text="Copyright © 2026 Mohamed Youssef" TextWrapping="Wrap"/>
     <TextBlock Grid.Row="1" Text="License" Foreground="{StaticResource MutedTextBrush}" Margin="0,12,0,0"/>
     <TextBlock Grid.Row="1" Grid.Column="1" Text="MIT License" Margin="0,12,0,0"/>
     <TextBlock Grid.Row="2" Text="GitHub" Foreground="{StaticResource MutedTextBrush}" Margin="0,12,0,0"/>
     <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,12,0,0" TextWrapping="Wrap">
      <Hyperlink Click="GitHubLink_Click" Foreground="{StaticResource AccentBrush}">https://github.com/mmyoussef199/CanvasLab-Public</Hyperlink>
     </TextBlock>
    </Grid>
   </StackPanel>
   <Button Grid.Row="2" Content="Close" IsDefault="True" IsCancel="True" Click="CloseButton_Click"
           Style="{StaticResource SmallButton}" HorizontalAlignment="Right" MinWidth="88" Margin="0,26,0,0"/>
  </Grid>
 </Border>
</Window>
