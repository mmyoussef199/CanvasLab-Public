<Window x:Class="CanvasLab.Views.HowToUseDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="How to Use CanvasLab" Icon="/CanvasLab;component/Assets/CanvasLab.ico"
 Width="620" Height="650" MinHeight="520" MaxHeight="780" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
 WindowStartupLocation="CenterOwner" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Grid Background="{StaticResource WindowBrush}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="26,22">
   <StackPanel>
    <TextBlock Text="How to Use CanvasLab" FontSize="25" FontWeight="SemiBold"/>
    <TextBlock Text="Everything stays on your computer." Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0"/>
   </StackPanel>
  </Border>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="26,22">
   <StackPanel>
    <Border Style="{StaticResource PanelCard}" Padding="20">
     <StackPanel>
      <TextBlock Text="Pick Colors" FontSize="19" FontWeight="SemiBold"/>
      <TextBlock Text="1. Select Open Image and choose a JPEG, PNG, or WebP file." TextWrapping="Wrap" Margin="0,14,0,0" LineHeight="21"/>
      <TextBlock Text="2. Select Pick Colors, then click the image." TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="21"/>
      <TextBlock Text="3. Read the exact color code, RGB values, alpha, and pixel position." TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="21"/>
      <TextBlock Text="4. Select Copy Color to copy the HEX code. Main Colors shows representative colors for the whole image." TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="21"/>
     </StackPanel>
    </Border>
    <Border Style="{StaticResource PanelCard}" Padding="20">
     <StackPanel>
      <TextBlock Text="Make Image Smaller" FontSize="19" FontWeight="SemiBold"/>
      <TextBlock Text="1. Open an image and choose JPEG, PNG, or WebP under Save As." TextWrapping="Wrap" Margin="0,14,0,0" LineHeight="21"/>
      <TextBlock Text="2. Enter a width or height. Keep Proportions updates the other value for you." TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="21"/>
      <TextBlock Text="3. Choose Image Quality for JPEG or WebP. PNG keeps full quality, so this setting is disabled." TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="21"/>
      <TextBlock Text="4. Select Make Image Smaller, then Preview to compare the result." TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="21"/>
      <TextBlock Text="5. Select Save Image and choose a new file name. CanvasLab does not overwrite the open image." TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="21"/>
     </StackPanel>
    </Border>
    <TextBlock Text="Tip: Use Fit or 100% above the image. Hold Ctrl and use the mouse wheel to zoom." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="4,2,4,0"/>
   </StackPanel>
  </ScrollViewer>
  <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="22,14">
   <Button Content="Close" IsDefault="True" IsCancel="True" Click="CloseButton_Click" Style="{StaticResource SmallButton}" HorizontalAlignment="Right" MinWidth="88"/>
  </Border>
 </Grid>
</Window>
